# ==============================================================================
# Acadlytic Environment Configuration Template (.env.example)
# Copy this file to .env and adjust values for your local environment.
# Never commit actual secret keys or production passwords to version control.
# ==============================================================================

# Database Configuration (MySQL)
MYSQL_DATABASE=acadlytic
MYSQL_USER=acadlytic_user
MYSQL_PASSWORD=acadlytic_password
MYSQL_ROOT_PASSWORD=root_password
MYSQL_HOST=localhost
MYSQL_PORT=3306

# Backend Configuration (Spring Boot)
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/acadlytic?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
SPRING_DATASOURCE_USERNAME=acadlytic_user
SPRING_DATASOURCE_PASSWORD=acadlytic_password

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Super Admin One-Time Bootstrap (ADR-17)
# Enable ONLY for initial setup when 0 SUPER_ADMIN accounts exist; set false and remove secrets afterward.
APP_BOOTSTRAP_SUPER_ADMIN_ENABLED=false
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
SUPER_ADMIN_FIRST_NAME=
SUPER_ADMIN_LAST_NAME=

# Mail / SMTP Configuration (Mailpit in dev, env-configured SMTP/TLS in prod — ADR-15)
SPRING_MAIL_HOST=localhost
SPRING_MAIL_PORT=1025
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
APP_MAIL_FROM=no-reply@acadlytic.local
APP_FRONTEND_BASE_URL=http://localhost:5173

# Frontend Configuration (Vite — prefer same-origin /api/v1 via Vite dev proxy)
VITE_PROXY_TARGET=http://localhost:8080
VITE_API_BASE_URL=/api/v1
VITE_APP_NAME=Acadlytic
VITE_APP_ENV=development
