# Vite Frontend Environment Variables (.env.example)
# In development, the browser talks to the Vite dev server at http://localhost:5173.
# Requests to /api are proxied to VITE_PROXY_TARGET to avoid CORS and ensure cookies stay same-site.

VITE_PROXY_TARGET=http://localhost:8080
VITE_API_BASE_URL=/api/v1
VITE_APP_NAME=Acadlytic
VITE_APP_ENV=development
