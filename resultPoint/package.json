{
  "name": "resultpoint",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "docs:resolve": "npx -y ctx7 library",
    "docs:query": "npx -y ctx7 docs",
    "test:browser": "npx -y @playwright/cli open http://localhost:5173 --browser chrome",
    "test:browser:mobile": "npx -y @playwright/cli open http://localhost:5173/calculators/cgpa --browser chrome --mobile",
    "design:extract": "npx -y skillui --dir ./src --out ./docs/design-system --name ResultPoint --format design-md"
  },
  "dependencies": {
    "@reduxjs/toolkit": "^2.13.0",
    "@tailwindcss/vite": "^4.3.3",
    "lucide-react": "^1.56.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-redux": "^9.3.0",
    "react-router-dom": "^7.18.4",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "vite": "^8.3.0"
